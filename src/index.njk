---
subject: World
title: Home
layout: base.njk
---
{% from "components/star.njk" import star %}

<h3 class="heading">新着記事！</h3>
<table>
  <colgroup>
    <col style="width: 60%;">
    <col style="width: 20%;">
    <col style="width: 20%;">
  </colgroup>
  <tbody>
    {%- for post in collections.posts %}
      <tr>
        <td><a href="{{ post.url }}">{{ post.data.title }}</a></td>
        <td>{{ star(post.data.star) }}</td>
        <td>{{ post.date | date("%Y-%m-%d") }}</td>
      </tr>
    {%- endfor %}
  </tbody>
</table>

